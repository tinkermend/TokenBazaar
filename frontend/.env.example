# API (usually same origin via reverse proxy)
# VITE_API_BASE_URL=/api/v1

# PriceAI portal — drives the C-end "Explore" menu and the post-logout return (hub mode).
# Unset/invalid => menu hidden and logout falls back to /login (standalone console).
# Same-origin production must still set this explicitly; hrefs then become relative paths.
# See docs/PRICEAI_PORTAL_NAV_SPEC.md
# Prefer same-origin hub proxy in local multi-app tests:
# VITE_PRICEAI_PUBLIC_ORIGIN=http://127.0.0.1:9080
VITE_PRICEAI_PUBLIC_ORIGIN=http://localhost:3000
# Portal must be mounted at the origin root: only unset or "/" is supported (spec §4.4).
# VITE_PRICEAI_PUBLIC_HOME_PATH=/
